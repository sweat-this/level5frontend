# Used by `npm run dev` (Next auto-loads this file for `next dev`).
# Level5Backend's CORS policy allows any loopback origin/port, so this works regardless of
# which port Next picks.
NEXT_PUBLIC_LEGACY_API_BASE_URL=http://localhost:5124

# Backend V2 local dev default (see v2/src/Level5.Api/Properties/launchSettings.json).
LEVEL5_V2_API_BASE_URL=http://localhost:5053
# Matches `next dev`'s default port.
LEVEL5_APP_ORIGIN=http://localhost:3000
# Enabled locally so the /api/auth-cert/* certification routes work out of the box.
LEVEL5_AUTH_CERTIFICATION_ENABLED=true

# Web-session storage defaults to LEVEL5_WEB_SESSION_STORE=memory when unset, which is what local
# dev uses here. To certify against a real Redis locally instead, uncomment and fill in:
# LEVEL5_WEB_SESSION_STORE=redis
# LEVEL5_WEB_SESSION_REDIS_URL=redis://localhost:6379
# LEVEL5_WEB_SESSION_ACTIVE_KEY_ID=dev
# LEVEL5_WEB_SESSION_KEYRING_JSON={"dev":"<base64-encoded-32-byte-key>"}
