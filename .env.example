# Base URL of the legacy Level5Backend V1 public API, no trailing slash.
# Local dev: see .env.development (already points at the local backend).
# Production build (`npm run build` uses .env.production): set this to the real deployed
# backend URL once one exists.
NEXT_PUBLIC_LEGACY_API_BASE_URL=http://localhost:5124

# Base URL this site is deployed at, no trailing slash. Used to resolve absolute Open Graph/
# Twitter image URLs (see src/app/layout.tsx's metadataBase). Optional - falls back to
# http://localhost:3000 when unset. Set this once a real deployment domain exists.
NEXT_PUBLIC_SITE_URL=

# --- Web authentication (BFF) - see docs/architecture/web-authentication.md ---
# These are server-only: deliberately NOT prefixed with NEXT_PUBLIC_, since the browser
# must never see a Backend V2 base URL, an access/refresh token, or these values.

# Base URL of Backend V2's API, no trailing slash. Local dev: see .env.development.
LEVEL5_V2_API_BASE_URL=

# This site's own public origin (scheme + host + port, no trailing slash). Used to
# validate the Origin header on cookie-authenticated mutation routes (login/logout) -
# see src/lib/web-auth/origin-policy.ts. Must match where the app is actually served.
LEVEL5_APP_ORIGIN=

# Enables the temporary /api/auth-cert/* certification routes used to prove the BFF
# session architecture end-to-end. Defaults to disabled, and is force-disabled in
# production regardless of this value (see src/lib/web-auth/config.ts) - these routes
# use whichever session store is configured below, and are not a permanent public API
# contract.
LEVEL5_AUTH_CERTIFICATION_ENABLED=false

# --- Web-session storage (issue #5) - see src/lib/web-auth/session-store-config.ts and
# docs/architecture/web-authentication.md ---
# All server-only, same reasoning as above. Never NEXT_PUBLIC_*.

# memory|redis. Defaults to memory outside production. Production MUST explicitly set this to
# redis - session-store-config.ts fails closed (throws) otherwise, and never silently falls back
# to the process-local memory store.
LEVEL5_WEB_SESSION_STORE=memory

# Required when LEVEL5_WEB_SESSION_STORE=redis. redis:// or rediss://, no trailing slash.
LEVEL5_WEB_SESSION_REDIS_URL=

# Required when LEVEL5_WEB_SESSION_STORE=redis. The keyId (from the keyring below) new session
# records are encrypted under. Older keys in the keyring stay readable for decryption without
# being written again - see the key-rotation runbook in
# docs/architecture/web-authentication.md.
LEVEL5_WEB_SESSION_ACTIVE_KEY_ID=

# Required when LEVEL5_WEB_SESSION_STORE=redis. A JSON object mapping each keyId to a
# base64-encoded 32-byte AES-256 key, e.g. {"k1":"<base64>"}. Generate a key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit real key material - this is server-only, secret configuration.
LEVEL5_WEB_SESSION_KEYRING_JSON=

# --- OpenTelemetry (issue #10) - see src/lib/otel/register.ts ---
# Entirely optional: unset, no collector is required and nothing is exported (safe for local
# dev/tests). These are the OTel SDK's own standard variable names, not level5-specific -
# @vercel/otel and the OTLP metric exporter both read them directly. Traces auto-export once
# OTEL_EXPORTER_OTLP_ENDPOINT (or the traces-specific variant) is set; metrics export only once
# OTEL_EXPORTER_OTLP_ENDPOINT or OTEL_EXPORTER_OTLP_METRICS_ENDPOINT is set (register.ts only
# attaches a metric reader then, so no background export attempts happen against a collector
# nobody configured). See https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=
