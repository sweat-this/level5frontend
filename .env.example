# Base URL of the legacy Level5Backend V1 public API, no trailing slash.
# Local dev: see .env.development (already points at the local backend).
# Production build (`npm run build` uses .env.production): set this to the real deployed
# backend URL once one exists.
NEXT_PUBLIC_LEGACY_API_BASE_URL=http://localhost:5124

# Base URL this site is deployed at, no trailing slash. Used to resolve absolute Open Graph/
# Twitter image URLs (see src/app/layout.tsx's metadataBase). Optional - falls back to
# http://localhost:3000 when unset. Set this once a real deployment domain exists.
NEXT_PUBLIC_SITE_URL=

# --- Web authentication (BFF) - see docs/architecture/web-authentication.md ---
# These are server-only: deliberately NOT prefixed with NEXT_PUBLIC_, since the browser
# must never see a Backend V2 base URL, an access/refresh token, or these values.

# Base URL of Backend V2's API, no trailing slash. Local dev: see .env.development.
LEVEL5_V2_API_BASE_URL=

# This site's own public origin (scheme + host + port, no trailing slash). Used to
# validate the Origin header on cookie-authenticated mutation routes (login/logout) -
# see src/lib/web-auth/origin-policy.ts. Must match where the app is actually served.
LEVEL5_APP_ORIGIN=

# Enables the temporary /api/auth-cert/* certification routes used to prove the BFF
# session architecture end-to-end. Defaults to disabled, and is force-disabled in
# production regardless of this value (see src/lib/web-auth/config.ts) - these routes
# are backed by a non-production in-memory session store (issue #5 owns the real one)
# and are not a permanent public API contract.
LEVEL5_AUTH_CERTIFICATION_ENABLED=false
