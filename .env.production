# Used by `npm run build` (`next build` natively loads .env.production).
# Left blank: there is no deployed backend to point at yet. Set this before building for a real
# deployment.
#
# This file stays tracked in git (unlike .env.development) - it's load-bearing, not just
# convenience. NEXT_PUBLIC_* vars are inlined into the client bundle at build time, not read at
# `next start` like the server-only vars documented in docs/operations/frontend-production.md, so
# an untracked/missing file here would make a fresh CI checkout build with this var literally
# `undefined` instead of the intentional empty string, breaking the relative-URL fetch fallback.
# Contains no secrets - confirm that stays true before adding anything here.
NEXT_PUBLIC_LEGACY_API_BASE_URL=

# NEXT_PUBLIC_SITE_URL is deliberately NOT set here, even blank: layout.tsx's fallback
# (`?? "http://localhost:3000"`) only triggers on the var being entirely unset, not on an empty
# string - `new URL("")` throws, which would break every build. Leave this var entirely absent
# from this file until a real deployment domain exists, then set it to the real URL (never
# blank) - see docs/operations/frontend-production.md's "Build and start".
